# 复制成 .env 再填值:cp .env.example .env && chmod 600 .env
#
# 至少填一个模型 key(流水线要调 LLM 扩写/审校)。三个都填最好,容灾链更稳。
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ---- 可选 ----
# 模型池,格式 provider:model,provider:model,...(留空用代码里的默认链)
# GRAMMAR_MODELS=google:gemini-flash-lite-latest,openrouter:qwen/qwen3.8-27b:free
# 只跑某几个阶段时用的并发数
# GRAMMAR_MAX_TOKENS=4096
# 等配额的超时(秒)
# GRAMMAR_WAIT_TIMEOUT=1800
# VOICEVOX engine 地址(例句朗读音频用,见 tts.py)
# VOICEVOX_URL=http://127.0.0.1:50021
